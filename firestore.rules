rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      // Allow user to read and write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated law enforcement officers to view officer directories
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['officer', 'admin'];
    }

    // Complaints collection
    match /complaints/{complaintId} {
      allow read, write: if request.auth != null;
    }

    // Default deny for other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
